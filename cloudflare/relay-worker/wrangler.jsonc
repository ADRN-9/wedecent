{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedecent-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "relay.wedecent.com",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "RELAY_METRICS",
      "dataset": "wedecent_relay_metrics"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1,
      "redact_query_string": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay"
      },
      {
        "name": "RELAY_RATE_LIMIT",
        "class_name": "ConnectionRateLimiter"
      }
    ]
  },
  "exports": {
    "DeviceRelay": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ConnectionRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
